# 财务单据智能风险审核系统 - 环境变量示例
# 复制为 back_endpoint/.env 后按需填写；.env 已被 .gitignore 忽略，请勿提交真实密钥。

# ========== 大模型（OpenAI 兼容 /chat/completions） ==========
# 留空 AI_API_KEY 时，系统自动使用规则 / 模板 / Mock 兜底，联调演示不中断。
AI_API_KEY=sk-xubkdbzyrkyyhxrbzertxwmtjdstdpotckdynjtamgdmomly
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:  https://api.openai.com/v1
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3.2-Exp

# 多模态识别模型（发票 / 行程单图片识别）。留空则附件解析使用 Mock。
# 例如：qwen-vl-plus、gpt-4o-mini
AI_VISION_MODEL=Qwen/Qwen3.8-27B
# 视觉模型可单独配置 Key / Base URL；留空则复用上面的 AI_API_KEY / AI_BASE_URL
AI_VISION_API_KEY=sk-xubkdbzyrkyyhxrbzertxwmtjdstdpotckdynjtamgdmomly
AI_VISION_BASE_URL=https://api.siliconflow.cn/v1

AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
# PDF 最多渲染前 N 页送给视觉模型
AI_MAX_PAGES=2

# ========== 数据库（可选覆盖 app/config.py 默认值） ==========
# DB_USER=root
# DB_PASSWORD=Root@123456
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=financial_risk_audit

# ========== 其他（可选） ==========
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=120
# STORAGE_DIR=D:/资料/三项/财务单据智能风险审核/back_endpoint/storage
