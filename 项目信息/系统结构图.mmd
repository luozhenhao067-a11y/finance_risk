flowchart TB
    %% ================= 前端 =================
    subgraph FE["前端 Vue 3 + Vite"]
        direction TB
        subgraph VIEWS["页面层 Views"]
            V1["登录 LoginView"]
            V2["工作台 DashboardView"]
            V3["单据管理 DocumentsView / 新建 / 详情"]
            V4["风险分析 RisksView"]
            V5["审批中心 ApprovalsView"]
            V6["报告中心 ReportView"]
            V7["系统管理 AdminView"]
            V8["审计日志 AuditLogsView"]
        end
        STORE["状态层 Store<br/>Pinia appStore<br/>state / actions / 权限判断"]
        subgraph APILAYER["接口层 API"]
            API1["api/index.js<br/>函数与后端接口一一对应"]
            API2["api/client.js<br/>axios + JWT 拦截器 + 统一响应解包"]
        end
        MOCK["Mock 降级<br/>mock/db.js<br/>VITE_USE_MOCK 开关"]
        VIEWS --> STORE
        STORE --> API1
        API1 --> API2
        API1 -. USE_MOCK=true .-> MOCK
    end

    %% ================= 后端 =================
    subgraph BE["后端 Java 17 + Spring Boot 3"]
        direction TB
        GATE["网关 / 认证<br/>Spring Security + JWT + RBAC"]
        subgraph CTRL["控制器层"]
            C1["AuthController"]
            C2["DocumentController"]
            C3["RiskController"]
            C4["ApprovalController"]
            C5["ReportController"]
            C6["AdminController"]
        end
        SVC["服务层<br/>单据 / 审批 / 报告 / 权限 / 规则配置"]
        SM["状态机服务<br/>draft → pending → approving → completed"]
        MQ["RocketMQ 异步任务链"]
        subgraph TASKS["异步任务"]
            T1["附件解析任务<br/>PDF 转图 + OCR + 字段结构化抽取"]
            T2["风险分析任务<br/>规则引擎逐条执行<br/>LLM 辅助判断(可选)"]
        end
        MINIO["MinIO 文件存储<br/>附件只读化快照"]
        REDIS["Redis<br/>会话 / 缓存 / 登录锁定"]
        GATE --> CTRL
        CTRL --> SVC
        SVC --> SM
        SVC -. 提交后发事件 .-> MQ
        MQ --> T1
        T1 -. 解析完成事件 .-> T2
        T2 -. 风险完成 .-> SM
        SVC --> MINIO
        GATE --> REDIS
    end

    %% ================= 数据库 =================
    subgraph DB["数据库 MySQL 8 + MyBatis-Plus"]
        direction TB
        T_USER["user / role / permission"]
        T_DOC["document / document_item<br/>attachment / attachment_parse_result"]
        T_RISK["risk_analysis / risk_item<br/>risk_evidence / risk_rule"]
        T_FLOW["approval_flow / approval_task<br/>audit_log / notification"]
        T_REPORT["report"]
    end

    %% ================= 数据流 =================
    API2 -- "HTTPS JSON<br/>/api/v1/*" --> GATE
    SVC --> DB
    SM --> DB
    T1 --> MINIO
    T1 --> DB
    T2 --> DB

    classDef view fill:#e3f2fd,stroke:#1976d2,color:#000
    classDef store fill:#fff9c4,stroke:#f9a825,color:#000
    classDef api fill:#e8f5e9,stroke:#388e3c,color:#000
    classDef mock fill:#f3e5f5,stroke:#8e24aa,color:#000
    classDef be fill:#fff3e0,stroke:#ef6c00,color:#000
    classDef db fill:#eceff1,stroke:#546e7a,color:#000
    class V1,V2,V3,V4,V5,V6,V7,V8 view
    class STORE store
    class API1,API2 api
    class MOCK mock
    class GATE,CTRL,SVC,SM,MQ,TASKS,T1,T2,MINIO,REDIS be
    class DB,T_USER,T_DOC,T_RISK,T_FLOW,T_REPORT db
